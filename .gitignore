node_modules/

# Section 0, boundary 2: retrieved source documents are processed within a run and
# written to reviewed output. They are never committed and never archived on a
# schedule. `runs/` is working space for the current run only.
runs/
*.pdf
demo-output/

# archive/ is deliberately NOT ignored. It holds reviewed output — records a
# person approved — which boundary 2 names as the permitted destination. It never
# holds a retrieved filing; pipeline/archive.mjs refuses anything unapproved, and
# test/archive.test.mjs fails if a document-sized string ever lands in one.

.DS_Store
.env
.env.*
!.env.example
